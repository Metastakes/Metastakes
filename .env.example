# =====================================================
# NeuroBridge Environment Configuration
# =====================================================
# NEVER commit real values to version control
# Copy this to .env.local and fill in actual values

# =====================================================
# Database (PostgreSQL)
# =====================================================
DATABASE_URL="postgresql://neurobridge:password@localhost:5432/neurobridge"
DATABASE_SSL_MODE="require"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# =====================================================
# Google Cloud Platform (BAA-covered services only)
# =====================================================
GCP_PROJECT_ID="neurobridge-prod"
GCP_REGION="us-central1"
GCP_SERVICE_ACCOUNT_KEY_PATH="./gcp-credentials.json"

# Vertex AI (Gemini)
VERTEX_AI_LOCATION="us-central1"
VERTEX_AI_MODEL="gemini-1.5-pro"
VERTEX_AI_ENDPOINT=""

# Google Calendar & Meet Integration (OAuth2)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="https://app.neurobridge.health/auth/google/callback"
GOOGLE_OAUTH_SCOPES="calendar.readonly,calendar.events"

# =====================================================
# Authentication & Security
# =====================================================
JWT_SECRET="REPLACE_WITH_SECURE_RANDOM_STRING_MIN_32_CHARS"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
SESSION_SECRET="REPLACE_WITH_SECURE_RANDOM_STRING"
ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_KEY"

# =====================================================
# PDMP Integration (E-FORCSE for Florida)
# =====================================================
PDMP_API_URL="https://florida.pmp.api.endpoint"
PDMP_API_KEY=""
PDMP_USERNAME=""
PDMP_PASSWORD=""
PDMP_FACILITY_ID=""

# =====================================================
# eRx Integration (DEA-compliant for controlled substances)
# =====================================================
ERX_PROVIDER="surescripts"
ERX_API_URL="https://api.surescripts.com"
ERX_API_KEY=""
ERX_FACILITY_NPI=""

# =====================================================
# Compliance & Audit
# =====================================================
RETENTION_YEARS=7
RETENTION_MINOR_AGE=25
AUDIT_LOG_RETENTION_YEARS=7
HIPAA_ENTITY_NAME="NeuroBridge Health, LLC"
HIPAA_ENTITY_STATE="Florida"

# DEA Telemedicine Extension (monitor & update)
DEA_TELEMEDICINE_EXTENSION_DATE="2025-12-31"

# =====================================================
# Application URLs
# =====================================================
API_BASE_URL="https://api.neurobridge.health"
PATIENT_PORTAL_URL="https://app.neurobridge.health"
PROVIDER_PORTAL_URL="https://provider.neurobridge.health"
MENTOR_PORTAL_URL="https://mentor.neurobridge.health"
ADMIN_PORTAL_URL="https://admin.neurobridge.health"

# =====================================================
# Feature Flags
# =====================================================
ENABLE_AI_LIVE_LOOP="true"
ENABLE_GAMIFICATION="true"
ENABLE_GLP1_MODULE="true"
ENABLE_MOTION_FEATURES="false"
ENABLE_RECORDING_CONSENT="true"

# =====================================================
# Localization
# =====================================================
DEFAULT_LOCALE="en"
SUPPORTED_LOCALES="en,es"

# =====================================================
# Monitoring & Telemetry (BAA-covered only)
# =====================================================
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
LOG_LEVEL="info"

# =====================================================
# Email & Notifications
# =====================================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@neurobridge.health"

# =====================================================
# Redis (for caching & sessions)
# =====================================================
REDIS_URL="redis://localhost:6379"
REDIS_TLS_ENABLED="true"

# =====================================================
# Rate Limiting
# =====================================================
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"
