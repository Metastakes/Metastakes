# ============================================================================
# NeuroBridge AI - Environment Variables Template
# Copy this to .env.local for development
# NEVER commit actual .env files to git
# ============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=NeuroBridge AI
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/neurobridge_dev
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ----------------------------------------------------------------------------
# Redis (Cache & Sessions)
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL=900

# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ----------------------------------------------------------------------------
# Google Cloud Platform
# ----------------------------------------------------------------------------
GCP_PROJECT_ID=neurobridge-dev
GCP_REGION=us-east1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Google Calendar API
GOOGLE_CALENDAR_API_KEY=your-calendar-api-key
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# Google Meet
GOOGLE_MEET_ENABLED=true

# Cloud Storage
GCS_BUCKET_NAME=neurobridge-dev-phi-storage
GCS_BUCKET_REGION=us-east1

# ----------------------------------------------------------------------------
# Vertex AI (Gemini)
# ----------------------------------------------------------------------------
VERTEX_AI_PROJECT=neurobridge-dev
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-1.5-flash-001
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.7
AI_FEEDBACK_ENABLED=true

# ----------------------------------------------------------------------------
# Stripe (Payments)
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Connect (Provider Payouts)
STRIPE_CONNECT_CLIENT_ID=ca_your_connect_client_id

# ----------------------------------------------------------------------------
# Insurance & Billing (Phase 2)
# ----------------------------------------------------------------------------
# Availity
AVAILITY_CLIENT_ID=your-availity-client-id
AVAILITY_CLIENT_SECRET=your-availity-client-secret
AVAILITY_ENVIRONMENT=sandbox

# Eligible API
ELIGIBLE_API_KEY=your-eligible-api-key
ELIGIBLE_ENVIRONMENT=test

# Waystar (Future)
WAYSTAR_CLIENT_ID=your-waystar-client-id
WAYSTAR_CLIENT_SECRET=your-waystar-client-secret
WAYSTAR_ENVIRONMENT=sandbox

# ----------------------------------------------------------------------------
# PDMP (Prescription Drug Monitoring)
# ----------------------------------------------------------------------------
PDMP_E_FORCSE_API_KEY=your-e-forcse-api-key
PDMP_E_FORCSE_STATE=FL
PDMP_CHECK_REQUIRED=true

# ----------------------------------------------------------------------------
# CAQH ProView (Credentialing)
# ----------------------------------------------------------------------------
CAQH_USERNAME=your-caqh-username
CAQH_PASSWORD=your-caqh-password
CAQH_ORGANIZATION_ID=your-org-id

# ----------------------------------------------------------------------------
# Email/SMS (Future - Twilio/SendGrid)
# ----------------------------------------------------------------------------
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@neurobridge.ai
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# ----------------------------------------------------------------------------
# Monitoring & Analytics
# ----------------------------------------------------------------------------
SENTRY_DSN=your-sentry-dsn
POSTHOG_API_KEY=your-posthog-api-key
NEXT_PUBLIC_POSTHOG_API_KEY=your-posthog-api-key
POSTHOG_HOST=https://app.posthog.com

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
ENABLE_GAMIFICATION=true
ENABLE_GLP1_PROGRAMS=true
ENABLE_AI_TRANSCRIPTION=true
ENABLE_MENTOR_PORTAL=true
ENABLE_INSURANCE_BILLING=false
ENABLE_ERX=false

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ----------------------------------------------------------------------------
# HIPAA Compliance
# ----------------------------------------------------------------------------
ENCRYPTION_KEY=your-32-byte-encryption-key-base64-encoded
SESSION_TIMEOUT_MINUTES=15
AUDIT_LOG_RETENTION_YEARS=7
DATA_RETENTION_DEFAULT_YEARS=7
DATA_RETENTION_MINOR_AGE_LIMIT=25

# ----------------------------------------------------------------------------
# Development Tools
# ----------------------------------------------------------------------------
DEBUG=false
LOG_LEVEL=info
ENABLE_QUERY_LOGGING=false
ENABLE_SWAGGER_UI=true

# ----------------------------------------------------------------------------
# Celery (Background Tasks)
# ----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# ----------------------------------------------------------------------------
# Testing
# ----------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/neurobridge_test
PYTEST_DISABLE_WARNINGS=true
